# Required: your OpenAI API key
OPENAI_API_KEY=your-api-key-here

# Optional overrides
RAG_MODEL=gpt-5
RAG_DOCS_DIR=data/documents
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150

# SQL connection string. Defaults to an in-memory SQLite database seeded with
# demo data. Point this at a real database to use your own data instead, e.g.:
# RAG_SQL_CONNECTION_STRING=postgresql+psycopg2://user:pass@host:5432/dbname
RAG_SQL_CONNECTION_STRING=sqlite:///:memory:
